DJANGO_SECRET_KEY=local-development-only-optimus-orien-not-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Set all of these for PostgreSQL (optional)
# POSTGRES_DB=optimus_orien
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=replace_me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Production requires DEBUG=false, HTTPS, strong random secret, host allowlist,
# a tested managed PostgreSQL database, backup/restore and trusted reverse proxy.
# Enable below ONLY behind a correctly configured reverse proxy:
# TRUST_REVERSE_PROXY=true
# DJANGO_SSL_REDIRECT=true

# Card Payment Provider Settings (Sandbox First)
# Options: 'fake' (default for local unit testing), 'paddle'
PAYMENT_PROVIDER=fake
PADDLE_API_KEY=paddlev2_sandbox_placeholder_api_key
PADDLE_WEBHOOK_SECRET=pdl_ntf_set_placeholder_webhook_secret
PADDLE_SANDBOX=true
PADDLE_CLIENT_TOKEN=test_placeholder_client_token
FRONTEND_BASE_URL=http://localhost:5173
