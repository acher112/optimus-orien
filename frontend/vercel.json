
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/proxy-health",
      "destination": "https://optimus-orien-api.onrender.com/api/health/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://optimus-orien-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
